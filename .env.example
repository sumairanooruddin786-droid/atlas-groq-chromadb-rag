# Groq API: used only for answer generation. Free key: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# FREE local embeddings (downloaded once, about 90 MB)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=64

# Chunks less similar than this are not sent to the model (cosine similarity, 0 to 1)
MIN_SIMILARITY=0.18
